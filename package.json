{
  "name": "portfolio-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "build:visual": "cross-env NEXT_PUBLIC_VISUAL_TEST=1 next build",
    "check:chunks": "node scripts/check-demo-chunks.mjs",
    "perf:lhci": "pnpm build && lhci autorun",
    "test:e2e:docker": "docker run --rm -it -v \"$PWD\":/work -v portfolio-site-node-modules:/work/node_modules -w /work -e CI=1 mcr.microsoft.com/playwright:v1.57.0-noble bash -lc 'corepack enable && pnpm install --frozen-lockfile && pnpm test:e2e'"
  },
  "dependencies": {
    "@next/mdx": "^16.3.1",
    "framer-motion": "^13.1.0",
    "gray-matter": "^4.0.3",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-frontmatter": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@next/eslint-plugin-next": "16.2.9",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
